# Copy this file to .env and fill in real values. .env is gitignored.

# Password of the MySQL root user (used by both the mysql service and the app).
MYSQL_ROOT_PASSWORD=change-me

# Spring datasource credentials. The app connects as root, so this password
# must be identical to MYSQL_ROOT_PASSWORD (left blank it falls back to it).
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Symmetric AES key used to encrypt stored passwords.
# Required: the application refuses to start without it.
# Must be exactly 16, 24 or 32 characters, e.g. `openssl rand -hex 16` (32 hex chars).
GREENBOTTLE_SECURITY_ENCRYPTION_KEY=change-me

# Cloudflare named tunnel token: https://one.dash.cloudflare.com -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=change-me
