# Copy this file to .env and fill in real values. .env is gitignored.

# Password of the MySQL root user (used by both the mysql service and the app).
MYSQL_ROOT_PASSWORD=change-me

# Spring datasource credentials.
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Cloudflare named tunnel token: https://one.dash.cloudflare.com -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=change--me

